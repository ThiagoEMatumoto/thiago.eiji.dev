---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Hero from '../../components/Hero.astro'
import About from '../../components/About.astro'
import HowIWork from '../../components/HowIWork.astro'
import Stack from '../../components/Stack.astro'
import ComponentsLab from '../../components/ComponentsLab.astro'
import Writing from '../../components/Writing.astro'
import Contact from '../../components/Contact.astro'
import Footer from '../../components/Footer.astro'
import { useTranslations, type Locale } from '../../i18n'

const locale: Locale = 'en'
const t = useTranslations(locale)
---

<BaseLayout title={t.meta.title} description={t.meta.description}>
  <Hero t={t.hero} />
  <About t={t.about} />
  <HowIWork t={t.howIWork} />
  <Stack t={t.stack} />
  <ComponentsLab t={t.componentsLab} />
  <Writing t={t.writing} />
  <Contact t={t.contact} />
  <Footer t={t.footer} locale={locale} />
</BaseLayout>
