---
import HeroTypewriter from './HeroTypewriter.tsx'
import type { Translations } from '../i18n'

interface Props {
  t: Translations['hero']
}

const { t } = Astro.props
---

<section
  class="relative flex min-h-screen flex-col px-6 py-10 sm:px-12 md:px-20"
  aria-label="hero"
>
  {/* Top label */}
  <header class="flex items-start">
    <span class="text-[11px] tracking-tight text-mute">{t.label}</span>
  </header>

  {/* Centered statement */}
  <div class="flex flex-1 items-center">
    <h1
      class="font-mono font-semibold tracking-[-0.04em] leading-[1.1] text-ink"
      style="font-size: clamp(40px, 8vw, 96px);"
    >
      <HeroTypewriter client:load text={t.statement} />
    </h1>
  </div>

  {/* Subtitle + footer */}
  <footer class="hero-fade-in flex flex-col gap-6">
    <p class="text-[13px] text-mute" style="opacity: 0.65;">
      {t.subtitle}
    </p>

    <div class="flex items-center justify-between">
      <ul class="flex items-center gap-5 text-[12px]">
        <li>
          <a
            href="mailto:thiagoeijimatumoto@gmail.com"
            class="inline-flex items-center gap-1.5 text-mute transition-colors hover:text-coral"
            aria-label="Email"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <span>{t.links.email}</span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/ThiagoEMatumoto"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-mute transition-colors hover:text-coral"
            aria-label="GitHub"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.18c-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5Z"
              ></path>
            </svg>
            <span>{t.links.github}</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/thiago-eiji-matumoto/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-mute transition-colors hover:text-coral"
            aria-label="LinkedIn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z"
              ></path>
            </svg>
            <span>{t.links.linkedin}</span>
          </a>
        </li>
      </ul>

      <a
        href="#about"
        class="text-[12px] text-mute transition-colors hover:text-coral"
      >
        {t.scrollCue}
      </a>
    </div>
  </footer>
</section>
