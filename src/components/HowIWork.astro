---
import EditorialSection from './EditorialSection.astro'

interface Principle {
  statement: string
  elaboration: string
}

interface Props {
  principles?: Principle[]
  label?: string
}

const {
  label = 'how i work',
  principles = [
    {
      statement: 'Produto primeiro.',
      elaboration:
        'Código é meio; o produto que resolve problema real é o fim.',
    },
    {
      statement: 'Entregue pequeno, itere rápido.',
      elaboration: 'Pronto em produção vence perfeito em PR.',
    },
    {
      statement: 'Domine a stack inteira.',
      elaboration: 'Do schema do banco à cor do botão.',
    },
    {
      statement: 'Ferramentas modernas, disciplina clássica.',
      elaboration: 'Dev assistido por IA com code review e testes.',
    },
    {
      statement: 'Simples vence.',
      elaboration:
        'Tecnologia chata na espinha, ferramentas novas onde compensam.',
    },
  ],
} = Astro.props
---

<EditorialSection id="how-i-work" number="02" label={label}>
  <ul class="space-y-6 text-base leading-relaxed md:text-lg">
    {
      principles.map((p) => (
        <li class="max-w-prose">
          <span class="text-coral" aria-hidden="true">
            →{' '}
          </span>
          <span class="font-semibold text-ink">{p.statement}</span>{' '}
          <span class="text-mute">{p.elaboration}</span>
        </li>
      ))
    }
  </ul>
</EditorialSection>
