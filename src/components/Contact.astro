---
import EditorialSection from './EditorialSection.astro'

interface Link {
  label: string
  display: string
  href: string
  external?: boolean
}

interface Props {
  links?: Link[]
}

const {
  links = [
    {
      label: 'email',
      display: 'thiagoeijimatumoto@gmail.com',
      href: 'mailto:thiagoeijimatumoto@gmail.com',
    },
    {
      label: 'github',
      display: '@ThiagoEMatumoto',
      href: 'https://github.com/ThiagoEMatumoto',
      external: true,
    },
    {
      label: 'linkedin',
      display: 'thiago-eiji-matumoto',
      href: 'https://www.linkedin.com/in/thiago-eiji-matumoto/',
      external: true,
    },
  ],
} = Astro.props
---

<EditorialSection id="contact" number="05" label="contact">
  <ul class="space-y-3 font-mono text-base md:text-lg">
    {
      links.map((link) => (
        <li class="group flex items-baseline gap-3">
          <span class="text-mute">{link.label}</span>
          <span class="text-mute transition-transform group-hover:translate-x-1">
            →
          </span>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-ink transition-colors group-hover:text-coral"
          >
            {link.display}
          </a>
        </li>
      ))
    }
  </ul>
</EditorialSection>
