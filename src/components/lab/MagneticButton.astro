---
interface Props {
  label: string
}
const { label } = Astro.props
---

<div class="magnetic-wrap flex h-full items-center justify-center">
  <button
    type="button"
    class="magnetic-btn group relative inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 font-mono text-sm text-canvas transition-[background-color,transform] duration-300 ease-out hover:bg-coral"
    aria-label={label}
  >
    <span>{label}</span>
    <span
      class="inline-block transition-transform duration-300 ease-out group-hover:translate-x-1"
      aria-hidden="true">→</span
    >
  </button>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const coarse = window.matchMedia('(pointer: coarse)').matches
  if (!reduced && !coarse) {
    document.querySelectorAll<HTMLElement>('.magnetic-wrap').forEach((wrap) => {
      const btn = wrap.querySelector<HTMLElement>('.magnetic-btn')
      if (!btn) return
      let raf = 0
      let tx = 0
      let ty = 0
      let inside = false

      const apply = () => {
        raf = 0
        btn.style.transform = inside
          ? `translate(${tx.toFixed(2)}px, ${ty.toFixed(2)}px) scale(1.05)`
          : ''
      }

      wrap.addEventListener('mousemove', (e) => {
        const r = wrap.getBoundingClientRect()
        tx = ((e.clientX - r.left) / r.width - 0.5) * 12
        ty = ((e.clientY - r.top) / r.height - 0.5) * 12
        inside = true
        if (!raf) raf = requestAnimationFrame(apply)
      })
      wrap.addEventListener('mouseleave', () => {
        inside = false
        tx = 0
        ty = 0
        if (!raf) raf = requestAnimationFrame(apply)
      })
    })
  }
</script>
