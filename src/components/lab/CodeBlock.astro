---
// Static syntax-highlighted code snippet. Pure HTML, zero JS.
---

<pre
  class="code-block flex h-full items-center overflow-x-auto rounded-lg bg-[#0E0E10] p-4 font-mono text-[13px] leading-relaxed text-[#d4d4d8]"
  aria-label="code snippet">
<code><span class="ck-c">// shipping is the strategy</span>
<span class="ck-kw">const</span> <span class="ck-fn">build</span> = () =&gt; <span class="ck-fn">ship</span>(<span class="ck-str">'soon'</span>)

<span class="ck-kw">await</span> <span class="ck-fn">build</span>()</code></pre>

<style>
  .code-block .ck-kw {
    color: #ff5f6d;
  }
  .code-block .ck-fn {
    color: #c099ff;
  }
  .code-block .ck-str {
    color: #5ee0e0;
  }
  .code-block .ck-c {
    color: #6b7280;
    font-style: italic;
  }
</style>
