---
interface Props {
  ariaLabel: string
}
const { ariaLabel } = Astro.props
---

<div class="flex h-full items-center justify-center">
  <button
    type="button"
    class="toggle relative inline-flex h-9 w-16 items-center rounded-full bg-ink p-1 transition-colors duration-300 hover:bg-[#2a2a2a]"
    aria-label={ariaLabel}
    aria-pressed="false"
  >
    <span
      class="toggle-knob inline-block h-7 w-7 rounded-full bg-coral shadow-[0_4px_12px_rgba(233,75,45,0.55)]"
      aria-hidden="true"></span>
  </button>
</div>

<style>
  .toggle-knob {
    transform: translateX(0);
    transition: transform 300ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .toggle:hover .toggle-knob {
    transform: translateX(28px);
  }
  @media (prefers-reduced-motion: reduce) {
    .toggle-knob {
      transition: none;
    }
  }
</style>
