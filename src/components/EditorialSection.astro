---
import SectionLabel from './SectionLabel.tsx'

interface Props {
  /** DOM id (used for in-page anchors). */
  id: string
  /** Two-digit section number, e.g. "01". */
  number: string
  /** Lowercase mono label, e.g. "about". */
  label: string
}

const { id, number, label } = Astro.props
---

<section
  id={id}
  class="border-t border-ink/10 px-6 py-24 md:px-12 md:py-32"
  aria-label={label}
>
  <div
    class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-[140px_1fr] md:gap-16"
  >
    <SectionLabel client:visible number={number} label={label} />
    <div>
      <slot />
    </div>
  </div>
</section>
